# Analog Block Configuration
BLOCK = @BLOCK_NAME@
PROJECT = @BLOCK_NAME@
TOP_SCHEMATIC = @BLOCK_NAME@
TOP_LAYOUT = @BLOCK_NAME@

# Sibling blocks this one is built from, space separated.
#
# A top-level block names the blocks it instantiates; a leaf names nothing. Listing a
# dependency puts its schematics/ in this block's schemify.project as a library, so its
# symbol can be placed here, and makes `make deps` build it first.
#
# Set with: make AddAnalogBlock BLOCK_NAME=ota DEPENDS="bandgap diffpair"
DEPENDS = @BLOCK_DEPENDS@

# Netlist dialect `make -C build/sim` hands `schemify run`: espice, or ngspice to
# cross-check a result against the reference simulator.
BACKEND ?= espice

# Layout outline for `make -C build/layout init_layout`. DEF_TEMPLATE, a DEF path from
# this block's directory (e.g. layout/outline.def), gives the die and pins when you have
# one; otherwise the die is DIE_AREA (x0 y0 x1 y1 in um) with one met4 port per PINS name.
DEF_TEMPLATE =
DIE_AREA = 0 0 100 100
PINS = VDD VSS
